{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidanrao.top/event-analytics/spec/v1/event.schema.json",
  "title": "Event Analytics v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_name",
    "local_time_ms",
    "properties"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "event_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "local_time_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "properties": {
      "type": "object"
    }
  }
}
