{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidanrao.top/event-analytics/spec/v1/protocol.schema.json",
  "title": "Event Analytics v1 ingestion request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "identity",
    "local_time",
    "events"
  ],
  "properties": {
    "context": {
      "type": "object",
      "required": [
        "app_id",
        "app_version",
        "platform",
        "os_name"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "app_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "os_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object"
    },
    "local_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "event.schema.json"
      }
    }
  }
}
